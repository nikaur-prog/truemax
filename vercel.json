{
  "functions": {
    "api/ai-image.ts": {
      "maxDuration": 300
    },
    "api/carousel-slide.ts": {
      "maxDuration": 180
    },
    "api/side-landmarks.ts": {
      "maxDuration": 60
    },
    "api/goal-preview.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/auth.html", "destination": "/auth", "permanent": true },
    { "source": "/quick.html", "destination": "/quick", "permanent": true },
    { "source": "/calib.html", "destination": "/calib", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/delete-account.html", "destination": "/delete-account", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/brand.html", "destination": "/brand", "permanent": true },
    { "source": "/league.html", "destination": "/league", "permanent": true },
    { "source": "/guides.html", "destination": "/guides", "permanent": true },
    { "source": "/face-score.html", "destination": "/face-score", "permanent": true },
    { "source": "/improve-your-looks.html", "destination": "/improve-your-looks", "permanent": true },
    { "source": "/looksmaxxing-guide.html", "destination": "/looksmaxxing-guide", "permanent": true },
    { "source": "/glow-up-guide.html", "destination": "/glow-up-guide", "permanent": true },
    { "source": "/methodology.html", "destination": "/methodology", "permanent": true }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/quick", "destination": "/quick.html" },
    { "source": "/calib", "destination": "/calib.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/brand", "destination": "/brand.html" },
    { "source": "/league", "destination": "/league.html" },
    { "source": "/league/tools", "destination": "/quick.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/face-score", "destination": "/face-score.html" },
    { "source": "/improve-your-looks", "destination": "/improve-your-looks.html" },
    { "source": "/looksmaxxing-guide", "destination": "/looksmaxxing-guide.html" },
    { "source": "/glow-up-guide", "destination": "/glow-up-guide.html" },
    { "source": "/methodology", "destination": "/methodology.html" }
  ],
  "crons": [
    { "path": "/api/cleanup-side-correction-feedback", "schedule": "15 3 * * *" },
    { "path": "/api/cleanup-goal-previews", "schedule": "30 3 * * *" },
    { "path": "/api/league-track", "schedule": "15 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tiktokcdn.com; media-src 'self' blob: mediastream:; font-src 'self'; connect-src 'self' https://ruvgkrlfmixfnmnzqgap.supabase.co wss://ruvgkrlfmixfnmnzqgap.supabase.co https://auth.truemax.app wss://auth.truemax.app; frame-src https://www.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), serial=(), bluetooth=(), display-capture=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/quick(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/calib(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/league(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/wasm/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
