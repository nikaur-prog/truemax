node_modules/
dist/
public/wasm/
public/models/selfie_multiclass_256x256.tflite
.DS_Store
*.local

# Secrets. This repo is public — Supabase keys and any other env values live in
# .env files locally and in the Vercel dashboard, never in git.
.env
.env.*
!.env.example

# Calibration photographs — the README, never the faces. See calib/README.md.
# Both spellings: the tools default to .calib/, older docs used calib/.
calib/*
!calib/README.md
.calib/
.reel-cache/
.vercel

# Working footage, and anything the app exported that got dropped in here.
#
# This repo is public, and the files in question are VIDEO OF PEOPLE'S FACES —
# source clips for edits, rendered rundowns, scan stills. None of it belongs in
# a public history, and none of it is recoverable once pushed: a later delete
# removes it from the working tree and leaves it in every clone.
#
# It nearly happened. Sorting exports into ~/TrueMax on a case-insensitive
# filesystem created those folders INSIDE this repo, because macOS treats
# ~/TrueMax and ~/truemax as one directory, and they landed untracked next to
# package.json. Loose fatthor-*.mp4 clips and a clips/ folder were already
# sitting there for the same reason: the repo root is where you happen to be
# standing when a file arrives.
#
# Videos are ignored by default, because the thing this rule exists to stop is
# a recording of somebody's face landing in a PUBLIC repo — and clips arrive in
# the repo root by accident, not by decision. Images are NOT ignored: the brand
# marks and demo portraits under public/ are legitimately versioned, and face
# images are covered by calib/ above.
*.mp4
*.mov
*.m4v
*.webm
clips/

# The one deliberate exception. public/tutorial/ holds generated instructional
# footage — nobody's real face — that has to ship for the tutorial to play.
# Anything added here is a decision, which is exactly what the blanket rule
# above is protecting against everywhere else.
!public/tutorial/*.mp4

# Same category, same decision: the League gate montage is a deterministic
# render (tools/build-montage.mjs) whose only face comes from the demo cast
# already versioned under public/demo, credited on its endcard. NOTE: the
# committed montage.mp4 predates that cast and still shows the Wikimedia
# portrait the harness used to load; re-rendering it replaces that face with a
# synthetic one.
!public/league/montage.mp4

# Same decision again: the landing reel's living-portrait loops and the
# voiced example are renders of AI-GENERATED cast faces, tagged as such on
# screen — nobody's real face. The blanket rule above silently kept the
# living-portrait clips out of the PR that shipped the reel, which is why
# this exception is explicit rather than a force-add nobody can see.
!public/demo/*.mp4

# The thirty-second CTA film, so /quick can hand it over as a finished file
# for the end of a TikTok rather than rendering thirty seconds in a browser.
#
# Allowed under the face-video rule above for the same reason public/demo/*.mp4
# is: the two people in it are AI-generated, tagged as such on screen, and the
# whole point of the file is to be distributed. Nobody's real face is in it.
# The 79MB of source frames, VO segments and actor stills it was built from
# stay in .cta-assets/, which is ignored; only the 6MB master ships.
!public/cta/*.mp4

# The export folders, in every casing the sorter might produce.
[Rr]eels/
[Rr]undowns/
[Ss]cans/
[Uu]nsorted/
Verdict?cards/

# Vite's dependency-optimiser cache. Written into the repo root whenever the
# dev server runs, including from the headless frame-check harness, so it turns
# up as an untracked directory after any session that looked at a rendered
# frame. A build cache, not source.
.vite/
supabase/.temp/

# Local visual exports created by the renderer and frame-check tools.
exports/

# Contact sheets from tools/rundown-sheet.mjs — regenerate, never commit.
.rundown-sheet/

# Working files from tools/build-voiced-example.mjs. The finished example
# ships as public/demo/voiced-example.mp4; the voice track and narration are
# intermediates.
.voiced-example/
.celeb-cache/
.cta-assets/
.side-dataset/
.preview-out/

# Scratch files from research harnesses. The side-seeder run drops probe copies
# of modules and one-off Chromium drivers into the tree while it works, and a
# `git add -A` has already carried two of them into a commit. They are working
# files, never product code. Most are named with a leading underscore; the
# side-seeder run also leaves probe-*.html drivers at the root, so those are
# named here too rather than waiting for one to be committed first.
src/**/_*.ts
tools/_*.mjs
_*.mjs
_*.html
probe-*.html

# Scratch worktrees created by isolated review agents. Same class as the
# entries above and named here for the same reason: the directory appears at
# the repo root while an agent is running, and a `git add -A` would carry
# somebody else's checkout into a public repository.
.claude/worktrees/
