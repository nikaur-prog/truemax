# The production Supabase project has safe public client defaults in the app.
# Set these only to override that project for local staging, a rotated key, or
# the branded production Auth domain after it is active. Do not point production
# at the hostname before Supabase has issued its certificate and activated it.
# Scan photos remain on-device by default. A side photo is sent only after a
# separate opt-in to landmark feedback. See docs/ACCOUNTS_SETUP.md and
# docs/SIDE_CORRECTION_FEEDBACK.md.
#
# The anon key is meant to be public in a web app — row-level security protects
# the data, not the key. Never put the service_role key here.
# Production target after activation: https://auth.truemax.app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel Function settings. These names do not start with VITE_, so
# Vite cannot place them in the browser bundle. Never paste their values into a
# client-side variable or commit a populated .env file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of the new secret key.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_MAX_ANNUAL_PRICE_ID=
STRIPE_SCAN_PRICE_ID=
STRIPE_MEMBER_SCAN_PRICE_ID=
# Optional dedicated decline price. When absent, the member scan price is used.
STRIPE_DOWNSELL_PRICE_ID=
STRIPE_VOICED_PRICE_ID=
# Creator League transfers remain fail-closed unless this is exactly "true".
# Enable in Preview with a test key first. Enable in Production only after the
# Connect recipient account, platform balance funding and legal checks pass.
LEAGUE_PAYOUTS_ENABLED=false
LEAGUE_PAYOUT_COUNTRIES=NZ
TRUEMAX_APP_URL=https://truemax.app

# --- Paid acquisition (optional) -------------------------------------------
# Unset, the conversion report in api/_attribution.ts does nothing at all, so
# attribution still lands in Stripe metadata and revenue-by-creative is still
# answerable from the Stripe dashboard. These only add the loop that tells
# TikTok which clicks became sales so its optimiser can chase them.
#
# From TikTok Events Manager: the web pixel's ID, and a Events API access token
# generated for it. The token is server-only and must never reach the bundle.
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=

# --- Creator carousel generation (optional) -------------------------------
# Both values are server-only. The endpoint is the single-image portrait
# generation endpoint enabled for the account. One API request produces one
# slide; the browser assembles titles, ranks and branding locally.
HF_CREDENTIALS=
HIGGSFIELD_CAROUSEL_ENDPOINT=
