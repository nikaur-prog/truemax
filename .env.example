# The production Supabase project has safe public client defaults in the app.
# Set these only to override that project for local staging or a rotated key.
# Scan photos remain on-device by default. A side photo is sent only after a
# separate opt-in to landmark feedback. See docs/ACCOUNTS_SETUP.md and
# docs/SIDE_CORRECTION_FEEDBACK.md.
#
# The anon key is meant to be public in a web app — row-level security protects
# the data, not the key. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel Function settings. These names do not start with VITE_, so
# Vite cannot place them in the browser bundle. Never paste their values into a
# client-side variable or commit a populated .env file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of the new secret key.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_MAX_ANNUAL_PRICE_ID=
STRIPE_SCAN_PRICE_ID=
STRIPE_MEMBER_SCAN_PRICE_ID=
# Optional dedicated decline price. When absent, the member scan price is used.
STRIPE_DOWNSELL_PRICE_ID=
STRIPE_VOICED_PRICE_ID=
TRUEMAX_APP_URL=https://truemax.app
